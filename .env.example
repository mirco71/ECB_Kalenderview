# Environment
NODE_ENV=production
PORT=3000

# JWT Secret - CHANGE THIS to a long random string (min. 16 chars)!
# In production the app REFUSES TO START with a missing/weak/placeholder value.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-string

# Database
DB_PATH=./data/calendar.db

# Calendar Settings
CALENDAR_NAME=Eisbelegung Eissporthalle Solingen
START_HOUR=6
END_HOUR=23

# Optional: restrict API access to a specific origin (CORS).
# Leave unset — the bundled frontend is same-origin and needs no CORS.
# Only set this if a separate web origin must call the API.
# CORS_ORIGIN=https://kalender.example.de
