function testFarbverteilung() {
  Logger.log('\n--- Statistik: Farbverteilung ---');
  
  const heute = new Date();
  const result = holeWochenTermine(heute.toISOString());
  
  if (result.termine.length === 0) {
    Logger.log('  Keine Termine für Statistik');
    return;
  }
  
  // Zähle Termine pro Farbe
  const verteilung = {};
  result.termine.forEach(termin => {
    const farbe = termin.farbName;
    verteilung[farbe] = (verteilung[farbe] || 0) + 1;
  });
  
  // Sortiere nach Häufigkeit
  const sortiert = Object.entries(verteilung).sort((a, b) => b[1] - a[1]);
  
  Logger.log(`  Farbverteilung (${result.termine.length} Termine):`);
  sortiert.forEach(([farbe, anzahl]) => {
    const prozent = ((anzahl / result.termine.length) * 100).toFixed(1);
    Logger.log(`    ${farbe}: ${anzahl} (${prozent}%)`);
  });
  
  assert(true, 'Farbverteilung analysiert');
}

function testDurchschnittlicheTermindauer() {
  Logger.log('\n--- Statistik: Termindauer ---');
  
  const heute = new Date();
  const result = holeWochenTermine(heute.toISOString());
  
  const zeitgebunden = result.termine.filter(t => !t.ganztaegig);
  
  if (zeitgebunden.length === 0) {
    Logger.log('  Keine zeitgebundenen Termine');
    return;
  }
  
  // Berechne Dauern
  const dauern = zeitgebunden.map(t => (t.ende - t.start) / (1000 * 60)); // in Minuten
  const summe = dauern.reduce((a, b) => a + b, 0);
  const durchschnitt = summe / dauern.length;
  const min = Math.min(...dauern);
  const max = Math.max(...dauern);
  
  Logger.log(`  Zeitgebundene Termine: ${zeitgebunden.length}`);
  Logger.log(`  Durchschnittliche Dauer: ${Math.round(durchschnitt)} Minuten (${(durchschnitt/60).toFixed(1)}h)`);
  Logger.log(`  Kürzester Termin: ${Math.round(min)} Minuten`);
  Logger.log(`  Längster Termin: ${Math.round(max)} Minuten (${(max/60).toFixed(1)}h)`);
  
  // Finde längsten Termin
  const laengsterIndex = dauern.indexOf(max);
  Logger.log(`  Längster Termin: "${zeitgebunden[laengsterIndex].titel}"`);
  
  assert(true, 'Termindauer analysiert');
}

// Helper für Datum-Tests (kopiert aus Frontend-Code)
function getMondayOfWeekTest(date) {
  const d = new Date(date);
  const day = d.getDay();
  const diff = d.getDate() - day + (day === 0 ? -6 : 1);
  return new Date(d.setDate(diff));
}

function getKalenderwocheTest(date) {
  const d = new Date(date);
  d.setHours(0, 0, 0, 0);
  d.setDate(d.getDate() + 4 - (d.getDay() || 7));
  const yearStart = new Date(d.getFullYear(), 0, 1);
  return Math.ceil((((d - yearStart) / 86400000) + 1) / 7);
}

