function testMehrtaegigeTermine() {
  Logger.log('\n--- Test: Mehrtägige Termine ---');
  
  const heute = new Date();
  const result = holeWochenTermine(heute.toISOString());
  
  if (result.termine.length === 0) {
    Logger.log('  Keine Termine zum Testen vorhanden');
    return;
  }
  
  // Finde mehrtägige Termine
  const mehrtaegig = result.termine.filter(termin => {
    const start = new Date(termin.start);
    const ende = new Date(termin.ende);
    
    // Entferne Zeitkomponente für Vergleich
    const startTag = new Date(start.getFullYear(), start.getMonth(), start.getDate());
    const endeTag = new Date(ende.getFullYear(), ende.getMonth(), ende.getDate());
    
    return endeTag > startTag;
  });
  
  Logger.log(`  Termine gesamt: ${result.termine.length}`);
  Logger.log(`  Mehrtägige Termine: ${mehrtaegig.length}`);
  
  if (mehrtaegig.length > 0) {
    mehrtaegig.forEach(t => {
      const dauer = Math.ceil((t.ende - t.start) / (1000 * 60 * 60 * 24));
      Logger.log(`    - "${t.titel}" dauert ${dauer} Tage`);
    });
    
    // Prüfe ob Start vor Ende liegt
    mehrtaegig.forEach(t => {
      assert(t.start < t.ende, `Termin "${t.titel}": Start nach Ende!`);
    });
  }
  
  assert(true, 'Mehrtägige Termine korrekt verarbeitet');
}

function testUeberlappenderTermine() {
  Logger.log('\n--- Test: Überlappende Termine ---');
  
  const heute = new Date();
  const result = holeWochenTermine(heute.toISOString());
  
  if (result.termine.length < 2) {
    Logger.log('  Zu wenige Termine für Überlappungs-Test');
    return;
  }
  
  // Finde überlappende Termine
  let ueberlappungen = 0;
  const zeitgebundeneTermine = result.termine.filter(t => !t.ganztaegig);
  
  for (let i = 0; i < zeitgebundeneTermine.length; i++) {
    for (let j = i + 1; j < zeitgebundeneTermine.length; j++) {
      const t1 = zeitgebundeneTermine[i];
      const t2 = zeitgebundeneTermine[j];
      
      // Prüfe Überlappung
      if (t1.start < t2.ende && t1.ende > t2.start) {
        ueberlappungen++;
        Logger.log(`  ⚠️ Überlappung: "${t1.titel}" und "${t2.titel}"`);
      }
    }
  }
  
  Logger.log(`  Überlappungen gefunden: ${ueberlappungen}`);
  
  if (ueberlappungen > 10) {
    Logger.log(`  ⚠️ Warnung: Viele Überlappungen (${ueberlappungen}) - evt. Doppelbuchungen?`);
  }
  
  assert(true, 'Überlappende Termine erkannt');
}

function testGrenzdatenWochenwechsel() {
  Logger.log('\n--- Test: Wochenwechsel-Grenzen ---');
  
  // Teste Montag 00:00
  const montag = new Date();
  montag.setHours(0, 0, 0, 0);
  while (montag.getDay() !== 1) {
    montag.setDate(montag.getDate() + 1);
  }
  
  const result1 = holeWochenTermine(montag.toISOString());
  assert(result1.erfolg, 'Montag 00:00 Abruf fehlgeschlagen');
  Logger.log(`  Montag 00:00: ${result1.termine.length} Termine`);
  
  // Teste Sonntag 23:59
  const sonntag = new Date(montag);
  sonntag.setDate(sonntag.getDate() - 1);
  sonntag.setHours(23, 59, 0, 0);
  
  const result2 = holeWochenTermine(sonntag.toISOString());
  assert(result2.erfolg, 'Sonntag 23:59 Abruf fehlgeschlagen');
  Logger.log(`  Sonntag 23:59: ${result2.termine.length} Termine`);
  
  // Prüfe ob es verschiedene Wochen sind
  const kw1 = getKalenderwocheTest(montag);
  const kw2 = getKalenderwocheTest(sonntag);
  
  Logger.log(`  KW Montag: ${kw1}, KW Sonntag: ${kw2}`);
  
  assert(true, 'Wochenwechsel korrekt behandelt');
}

