function testSonderzeitTermine() {
  Logger.log('\n--- Test: Termine außerhalb 6-23 Uhr ---');
  
  const heute = new Date();
  const result = holeWochenTermine(heute.toISOString());
  
  let vorStartzeit = 0;
  let nachEndzeit = 0;
  
  result.termine.filter(t => !t.ganztaegig).forEach(termin => {
    const start = new Date(termin.start);
    const stunde = start.getHours();
    
    if (stunde < START_STUNDE) {
      vorStartzeit++;
      Logger.log(`  ⚠️ Termin vor ${START_STUNDE} Uhr: "${termin.titel}" um ${stunde}:${start.getMinutes()}`);
    }
    
    if (stunde >= END_STUNDE) {
      nachEndzeit++;
      Logger.log(`  ⚠️ Termin nach ${END_STUNDE} Uhr: "${termin.titel}" um ${stunde}:${start.getMinutes()}`);
    }
  });
  
  Logger.log(`  Termine vor ${START_STUNDE} Uhr: ${vorStartzeit}`);
  Logger.log(`  Termine nach ${END_STUNDE} Uhr: ${nachEndzeit}`);
  
  if (vorStartzeit > 0 || nachEndzeit > 0) {
    Logger.log(`  ℹ️ Hinweis: Diese Termine werden im Kalender möglicherweise nicht vollständig angezeigt`);
  }
  
  assert(true, 'Sonderzeit-Termine erkannt');
}

function testSonderzeichenImTitel() {
  Logger.log('\n--- Test: Sonderzeichen im Titel ---');
  
  const heute = new Date();
  const result = holeWochenTermine(heute.toISOString());
  
  const gefaehrlicheZeichen = ['<', '>', '"', "'", '&', 'script', 'javascript:'];
  let gefunden = 0;
  
  result.termine.forEach(termin => {
    gefaehrlicheZeichen.forEach(zeichen => {
      if (termin.titel.toLowerCase().includes(zeichen.toLowerCase())) {
        gefunden++;
        Logger.log(`  ⚠️ Gefährliches Zeichen in: "${termin.titel}"`);
      }
    });
  });
  
  Logger.log(`  Termine mit Sonderzeichen: ${gefunden}`);
  
  if (gefunden > 0) {
    Logger.log(`  ℹ️ Hinweis: Prüfe ob HTML-Escaping korrekt funktioniert`);
  }
  
  assert(true, 'Sonderzeichen-Test abgeschlossen');
}

function testZeitumstellung() {
  Logger.log('\n--- Test: Zeitumstellung ---');
  
  // Sommerzeit: Letzter Sonntag im März
  const maerz = new Date(new Date().getFullYear(), 2, 31); // 31. März
  while (maerz.getDay() !== 0) {
    maerz.setDate(maerz.getDate() - 1);
  }
  
  // Winterzeit: Letzter Sonntag im Oktober
  const oktober = new Date(new Date().getFullYear(), 9, 31); // 31. Oktober
  while (oktober.getDay() !== 0) {
    oktober.setDate(oktober.getDate() - 1);
  }
  
  const resultMaerz = holeWochenTermine(maerz.toISOString());
  const resultOktober = holeWochenTermine(oktober.toISOString());
  
  assert(resultMaerz.erfolg, 'Sommerzeit-Woche Abruf fehlgeschlagen');
  assert(resultOktober.erfolg, 'Winterzeit-Woche Abruf fehlgeschlagen');
  
  Logger.log(`  Sommerzeit-Woche (März): ${resultMaerz.termine.length} Termine`);
  Logger.log(`  Winterzeit-Woche (Oktober): ${resultOktober.termine.length} Termine`);
  
  assert(true, 'Zeitumstellung wird behandelt');
}

